&constants
 G_GRAVITY = 6.67259d-8
/
&model
 model_type = 'EVOL'
 file = '../../data/wdec-evolved'
 file_format = 'WDEC'
/
&mode
 l = 1
/
&mode
 l = 2
/
&osc
 outer_bound = 'VACUUM'
 adiabatic = .true.
 nonadiabatic = .false.
 inertia_norm = 'BOTH'
/
&rot
/
&num
 diff_scheme = 'COLLOC_GL6'
/
&scan
 grid_type = 'INVERSE'
 freq_min = 0.001
 freq_max = 0.005
 freq_min_units = 'HZ'
 freq_max_units = 'HZ'
 n_freq = 1200
/
&grid
 w_osc = 40
 w_exp = 8.0
 w_ctr = 40
/
&ad_output
 summary_file = 'summary.h5'
 summary_item_list = 'id,l,n_pg,n_p,n_g,omega,freq,E_norm'
 freq_units = 'HZ'
 detail_file_format = 'HDF'
  detail_template = 'mode.%l.%n_pg.h5'
  detail_item_list = 'l,n_pg,n_g,n_p,freq,E_norm,x,xi_r,xi_h,lag_P,lag_rho,lag_T,prop_type'

/
&nad_output
/
